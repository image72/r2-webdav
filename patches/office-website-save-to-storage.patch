From a73ceccca6a9ab53d62816740561449e45628f16 Mon Sep 17 00:00:00 2001
From: allan <image72@msn.com>
Date: Sat, 26 Sep 2026 04:24:58 +0800
Subject: [PATCH 1/2] feat: save back to storage via saveUrl query param

- EditorServer.openUrl accepts saveUrl; converted output is PUT to it on
  save (r2-webdav write_document), local download kept as fallback
- editor page reads ?saveUrl= and threads it into the server; save
  failures surface via editor.showMessage
- _headers: cache x2t wasm 30d + SWR, HTML short TTL
---
 app/editor/page.tsx    | 11 +++++++++++
 public/_headers        | 28 ++++++++++++++++++++++++++++
 utils/editor/server.ts | 40 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 79 insertions(+)

diff --git a/app/editor/page.tsx b/app/editor/page.tsx
index 54c20c6..21120f3 100644
--- a/app/editor/page.tsx
+++ b/app/editor/page.tsx
@@ -46,6 +46,7 @@ export default function Page() {
     const fileId = searchParams.get("fileId");
     const newDoc = searchParams.get("new");
     const fileUrl = searchParams.get("url");
+    const saveUrl = searchParams.get("saveUrl");
     const paramEditing = searchParams.get("editing");
     const paramLang = searchParams.get("lang");
     const paramTheme = searchParams.get("theme");
@@ -184,6 +185,15 @@ export default function Page() {
           onSave: (e: unknown) => {
             console.log("onSave", e);
             isDirty.current = false;
+            // 保存后检查回写存储的结果，有错就提示（本地下载不受影响）。
+            const saveError = server.getSaveError();
+            if (saveError) {
+              console.error("save -> storage failed:", saveError);
+              editor?.showMessage(
+                "Save",
+                "Saved to disk, but writing back to storage failed: " + saveError,
+              );
+            }
           },
           writeFile: async (e: unknown) => {
             console.log("writeFile", e);
@@ -234,6 +244,7 @@ export default function Page() {
         server.openUrl(fileUrl, {
           fileType: searchParams.get("fileType") || '',
           fileName: searchParams.get("fileName") || '',
+          saveUrl: saveUrl || undefined,
           loader,
         })
       }
diff --git a/public/_headers b/public/_headers
index e3c2221..060311e 100644
--- a/public/_headers
+++ b/public/_headers
@@ -19,3 +19,31 @@
 # template files
 /files/*
     Cache-Control: public, max-age=86400
+
+# x2t（无 hash，改版本时切目录名 /x2t-N/ 失效；主线程用 /x2t，worker 用 /x2t-1）
+/x2t/*
+    Content-Encoding: br
+    Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
+
+/x2t-1/*
+    Content-Encoding: br
+    Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
+
+# HTML 页面：浏览器短存 + CDN 缓存一天（发版后 CDN 最多滞后一天，浏览器 5 分钟内重验证）
+/
+    Cache-Control: public, max-age=300, s-maxage=86400
+
+/editor
+    Cache-Control: public, max-age=300, s-maxage=86400
+
+/editor/*
+    Cache-Control: public, max-age=300, s-maxage=86400
+
+/about
+    Cache-Control: public, max-age=300, s-maxage=86400
+
+/settings
+    Cache-Control: public, max-age=300, s-maxage=86400
+
+/template
+    Cache-Control: public, max-age=300, s-maxage=86400
diff --git a/utils/editor/server.ts b/utils/editor/server.ts
index 1b94642..d918af6 100644
--- a/utils/editor/server.ts
+++ b/utils/editor/server.ts
@@ -52,6 +52,14 @@ export class EditorServer {
   private downloadId: string = "";
   private downloadParts: Uint8Array[] = [];
 
+  /**
+   * 保存回写地址（r2-webdav 的 /onlyoffice/doc/<write-token>）。
+   * 设置后每次 save 成功除本地下载外，还会把转换结果 PUT 到这里；
+   * 失败只打 console，不阻塞本地下载 —— 磁盘永远是保底出路。
+   */
+  private saveUrl: string | null = null;
+  private saveError: string | null = null;
+
   private options: ServerOptions = {};
 
   constructor(options: ServerOptions = {}) {
@@ -122,10 +130,13 @@ export class EditorServer {
     {
       fileType,
       fileName,
+      saveUrl,
       loader = (url: string) => fetch(url).then((res) => res.arrayBuffer()),
     }: {
       fileType?: string;
       fileName?: string;
+      /** r2-webdav 签发的写回短链；给了才启用「保存回写存储」。 */
+      saveUrl?: string;
       loader?: (url: string) => Promise<ArrayBuffer>;
     } = {},
   ) {
@@ -134,6 +145,8 @@ export class EditorServer {
     const documentType = getDocumentType(this.fileType);
     this.id = randomId();
     this.title = title;
+    this.saveUrl = saveUrl || null;
+    this.saveError = null;
     this.loadPromise = this.loadDocument(() => loader(url), this.fileType);
 
     return {
@@ -142,6 +155,11 @@ export class EditorServer {
     };
   }
 
+  /** 最近一次回写存储的结果：null = 未尝试 / 成功后的清除；否则是错误消息。 */
+  getSaveError(): string | null {
+    return this.saveError;
+  }
+
   getDocument() {
     if (!this.id) {
       this.openNew();
@@ -423,6 +441,28 @@ export class EditorServer {
           // TODO: error message
           return { status: "error" };
         }
+
+        // 回写存储：r2-webdav 的 saveUrl（写 token 短链）。放在本地下载之前：
+        // 失败不阻塞下载，磁盘永远是保底出路；成功后清掉上次的错误标记。
+        if (this.saveUrl) {
+          this.saveError = null;
+          try {
+            const put = await fetch(this.saveUrl, {
+              method: "PUT",
+              headers: { "Content-Type": "application/octet-stream" },
+              body: new Blob([new Uint8Array(output)]),
+            });
+            if (!put.ok) {
+              const text = await put.text().catch(() => "");
+              throw new Error(`PUT ${put.status} ${text.slice(0, 120)}`);
+            }
+            console.log("save -> storage OK", this.title, output.byteLength, "bytes");
+          } catch (err) {
+            this.saveError = String(err instanceof Error ? err.message : err);
+            console.error("save -> storage FAILED:", this.saveError);
+          }
+        }
+
         const blob = new Blob([new Uint8Array(output)]);
         const url = URL.createObjectURL(blob);
         const a = document.createElement("a");
