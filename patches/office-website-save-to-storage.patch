From 0894bf90936662e8368318c638d82ac11c6d58e5 Mon Sep 17 00:00:00 2001
From: allan <image72@msn.com>
Date: Sat, 26 Sep 2026 04:49:10 +0800
Subject: [PATCH 2/2] fix: save-to-storage is authoritative, download only as
 fallback

When saveUrl is set, converted output is PUT back and no local download
happens; download kicks in only if the PUT fails. Without saveUrl the
behavior is byte-for-byte upstream-identical (download only).
---
 utils/editor/server.ts | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/utils/editor/server.ts b/utils/editor/server.ts
index d918af6..f3db5a7 100644
--- a/utils/editor/server.ts
+++ b/utils/editor/server.ts
@@ -54,8 +54,9 @@ export class EditorServer {
 
   /**
    * 保存回写地址（r2-webdav 的 /onlyoffice/doc/<write-token>）。
-   * 设置后每次 save 成功除本地下载外，还会把转换结果 PUT 到这里；
-   * 失败只打 console，不阻塞本地下载 —— 磁盘永远是保底出路。
+   * 设置后保存以 PUT 回写为准，不再本地下载；回写失败才退回本地下载兜底，
+   * 错误存入 saveError（页面 onSave 时读取并提示）。
+   * 不设置（上游默认场景）行为完全不变：转换结果落本地下载。
    */
   private saveUrl: string | null = null;
   private saveError: string | null = null;
@@ -442,8 +443,10 @@ export class EditorServer {
           return { status: "error" };
         }
 
-        // 回写存储：r2-webdav 的 saveUrl（写 token 短链）。放在本地下载之前：
-        // 失败不阻塞下载，磁盘永远是保底出路；成功后清掉上次的错误标记。
+        // 回写存储：r2-webdav 的 saveUrl（写 token 短链）。
+        // 带了 saveUrl 就以回写为准（不再每次保存都往下载目录丢文件）；
+        // 回写失败才退回本地下载，保证劳动成果不丢。
+        // 没有 saveUrl（上游默认场景）→ 不走这段，行为与原来完全一致。
         if (this.saveUrl) {
           this.saveError = null;
           try {
@@ -457,9 +460,10 @@ export class EditorServer {
               throw new Error(`PUT ${put.status} ${text.slice(0, 120)}`);
             }
             console.log("save -> storage OK", this.title, output.byteLength, "bytes");
+            return { status: "ok" };
           } catch (err) {
             this.saveError = String(err instanceof Error ? err.message : err);
-            console.error("save -> storage FAILED:", this.saveError);
+            console.error("save -> storage FAILED, falling back to download:", this.saveError);
           }
         }
 
